APP_ENV=demo

# Dev mode uses SQLite unless DATABASE_URL is set.
ERP_DB_PATH=data/erp_demo.db

# Demo/production mode uses MySQL when APP_ENV=demo or APP_ENV=production.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_demo
DB_USER=erp_user
DB_PASSWORD=Local@ErpDemo#2026_Strong
MYSQL_ROOT_PASSWORD=Local@MysqlRoot#2026_Strong

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# SQL Server database lab. Use a strong password locally.
SQLSERVER_SA_PASSWORD=Local@SqlServer#2026_Strong
